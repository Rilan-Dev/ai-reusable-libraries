{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rilan-Dev/doable-source/capabilities/CAPABILITY_MANIFEST.schema.json",
  "title": "Doable Source Capability Manifest",
  "description": "Canonical machine-readable contract for future capability manifests. Existing MANIFEST.md files remain authoritative until explicitly migrated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "runtimeSource",
    "requiredSystems",
    "uiReference",
    "requiredBehavior",
    "hostBindings",
    "completionCriteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "runtimeSource": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredSystems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uiReference": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredBehavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hostBindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completionCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "externalDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
