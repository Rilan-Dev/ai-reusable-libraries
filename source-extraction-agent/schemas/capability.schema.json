{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Extraction Capability",
  "type": "object",
  "required": ["id", "name", "tier", "disposition", "source_paths", "evidence_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string"},
    "tier": {"enum": [1, 2, 3]},
    "disposition": {"enum": ["reusable-core", "dependency-closure", "ui-reference", "host-boundary", "product-only", "not-applicable"]},
    "source_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entry_points": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "host_boundaries": {"type": "array", "items": {"type": "string"}},
    "evidence_status": {"enum": ["unreviewed", "in-progress", "partial", "pass", "blocked"]},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
